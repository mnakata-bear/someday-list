rules_version = '2';

// いつかやることリスト(許可された 2 アカウントで、1 つのリストを共有する)
//   spaces/home/tasks/{taskId}   タスク
//   spaces/home/meta/settings    見た目の設定
//   spaces/home/meta/stats       スタンプの累計
// 許可リストのメール(確認済み)でログインしていれば、どのアカウントでも spaces/home を読み書きできる(uid は問わない)。
// 旧データ users/{uid}/... は、共有スペースへの移行用に「本人の read と delete」だけ残す(書き込みは不可)。
// それ以外はすべて拒否。
service cloud.firestore {
  match /databases/{database}/documents {

    // このアプリを使えるアカウント(Google のメール)。増やすときはこのリストに足す。
    // クライアント側の同じリストは src/core/access.ts(見た目用。守りの本体はここ)
    function allowedEmail() {
      return request.auth.token.email in ['naka.mutora3@gmail.com', 'naka.mutora7@gmail.com'];
    }

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && allowedEmail();
    }

    match /spaces/home {
      function validTask(d) {
        return d.keys().hasOnly(['title', 'due', 'note', 'label', 'done', 'doneAt', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['title', 'due', 'done', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
          && d.due is string && (d.due == '' || d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && (!('note' in d) || (d.note is string && d.note.size() <= 2000))
          && (!('label' in d) || d.label in ['work', 'private', ''])
          && d.done is bool
          && (!('doneAt' in d) || d.doneAt == null || d.doneAt is int)
          && d.createdAt is int
          && d.updatedAt is int;
      }

      match /tasks/{taskId} {
        allow read, delete: if isMember();
        allow create, update: if isMember() && taskId.size() <= 64 && validTask(request.resource.data);
      }

      match /meta/settings {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['layout', 'theme', 'wp', 'stamp'])
          && request.resource.data.layout in ['a', 'c']
          && request.resource.data.theme is string && request.resource.data.theme.size() <= 32
          && request.resource.data.wp is string && request.resource.data.wp.size() <= 32
          && request.resource.data.stamp in ['sumi', 'kanryo', 'done', 'good'];
        allow delete: if isMember();
      }

      match /meta/stats {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.resource.data.keys().hasOnly(['stampTotal'])
          && request.resource.data.stampTotal is int
          && request.resource.data.stampTotal >= 0;
        allow delete: if isMember();
      }
    }

    // 旧データ(1 アカウント 1 リスト時代)。移行のため、本人が読んで消すことだけできる
    match /users/{userId}/{document=**} {
      allow read, delete: if isMember() && request.auth.uid == userId;
    }

    // ここに書かれていない場所は、すべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
